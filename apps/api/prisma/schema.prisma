generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["alym"]
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String?
  username     String?  @unique
  githubId     String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  teams        Team[]

  @@schema("alym")
}

model Team {
  id               Int      @id @default(autoincrement())
  userId           Int
  name             String   @unique
  nation           String?
  stadiumName      String?
  badgeDesign      Int?
  budget           Float    @default(200000)
  reputation       Int      @default(50)
  wins             Int      @default(0)
  draws            Int      @default(0)
  losses           Int      @default(0)
  goldBalance      Int      @default(0)
  tacticalVision   String   @default("standard")
  jobSecurity      Int      @default(70)
  youthPromoted    Int      @default(0)
  challengeId      String?
  challengeWins    Int      @default(0)
  challengeMatches Int      @default(0)
  challengeStreak  Int      @default(0)
  challengeYouth   Int      @default(0)
  createdAt        DateTime @default(now())

  user         User           @relation(fields: [userId], references: [id])
  players      Player[]
  messages     Message[]
  transactions Transaction[]
  achievements Achievement[]
  careerEvents CareerEvent[]
  staff         StaffMember[]
  negotiations  TransferNegotiation[]
  standings     LeagueStanding[]
  chronicle     ChronicleEntry[]

  @@schema("alym")
}

model Player {
  id            Int       @id @default(autoincrement())
  name          String
  position      String
  nation        String?
  salary        Float
  speed         Int
  dribble       Int
  shot          Int
  pass          Int
  defense       Int
  physique      Int
  potential     Int       @default(70)
  isYouth       Boolean   @default(false)
  onLoan        Boolean   @default(false)
  trainingPlan  String    @default("balanced")
  isLegend      Boolean   @default(false)
  contractUntil DateTime?
  teamId        Int?
  createdAt     DateTime  @default(now())

  team Team? @relation(fields: [teamId], references: [id])

  @@schema("alym")
}

model League {
  id         Int       @id @default(autoincrement())
  name       String
  season     Int
  tier       Int
  teamsCount Int
  startDate  DateTime?
  endDate    DateTime?
  createdAt  DateTime  @default(now())
  matches    Match[]

  @@schema("alym")
}

model Match {
  id         Int       @id @default(autoincrement())
  leagueId   Int
  homeTeamId Int
  awayTeamId Int
  homeScore  Int?
  awayScore  Int?
  matchDate  DateTime?
  status     String    @default("scheduled")
  events     String?
  createdAt  DateTime  @default(now())

  league League @relation(fields: [leagueId], references: [id])

  @@schema("alym")
}

model Message {
  id          Int      @id @default(autoincrement())
  teamId      Int
  sender      String
  title       String
  content     String
  messageDate DateTime @default(now())
  read        Boolean  @default(false)

  team Team @relation(fields: [teamId], references: [id])

  @@schema("alym")
}

model Transaction {
  id              Int      @id @default(autoincrement())
  teamId          Int
  type            String
  amount          Float
  reason          String?
  transactionDate DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id])

  @@schema("alym")
}

model Achievement {
  id              Int      @id @default(autoincrement())
  teamId          Int
  achievementCode String
  unlockedAt      DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id])

  @@schema("alym")
}

model AiManager {
  id              Int      @id @default(autoincrement())
  name            String
  nation          String?
  reputation      Int      @default(50)
  preferredVision String   @default("standard")
  status          String   @default("free")
  seasonsAtClub   Int      @default(0)
  createdAt       DateTime @default(now())

  club AiClub?

  @@schema("alym")
}

model AiClub {
  id             Int      @id @default(autoincrement())
  name           String   @unique
  nation         String?
  reputation     Int      @default(50)
  budget         Float    @default(150000)
  tacticalVision String   @default("standard")
  leagueTier     Int      @default(2)
  jobSecurity    Int      @default(70)
  wins           Int      @default(0)
  draws          Int      @default(0)
  losses         Int      @default(0)
  managerId      Int?     @unique
  createdAt      DateTime @default(now())

  manager AiManager? @relation(fields: [managerId], references: [id])

  @@schema("alym")
}

model ManagerMarketEvent {
  id        Int      @id @default(autoincrement())
  type      String
  clubName  String
  managerName String?
  detail    String?
  createdAt DateTime @default(now())

  @@schema("alym")
}

// Career event engine
model CareerEvent {
  id               String    @id @default(cuid())
  teamId           Int
  type             String
  priority         String    @default("important")
  title            String
  body             String
  contextJson      String?
  optionsJson      String
  status           String    @default("pending")
  choiceId         String?
  consequenceNote  String?
  consequenceJson  String?
  createdAt        DateTime  @default(now())
  resolvedAt       DateTime?
  expiresAt        DateTime?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, status])
  @@schema("alym")
}

model LeagueStanding {
  id            Int      @id @default(autoincrement())
  leagueKey     String   @default("super_ligue_1")
  season        Int      @default(1)
  teamName      String
  isPlayer      Boolean  @default(false)
  playerTeamId  Int?
  played        Int      @default(0)
  wins          Int      @default(0)
  draws         Int      @default(0)
  losses        Int      @default(0)
  goalsFor      Int      @default(0)
  goalsAgainst  Int      @default(0)
  points        Int      @default(0)
  form          String   @default("")
  updatedAt     DateTime @updatedAt

  team Team? @relation(fields: [playerTeamId], references: [id], onDelete: Cascade)

  @@unique([leagueKey, season, teamName])
  @@index([leagueKey, season, points])
  @@schema("alym")
}

model StaffMember {
  id        Int      @id @default(autoincrement())
  teamId    Int
  role      String
  name      String
  rating    Int      @default(60)
  salary    Float    @default(1000)
  specialty String?
  hiredAt   DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@schema("alym")
}

model TransferNegotiation {
  id             String   @id @default(cuid())
  teamId         Int
  playerName     String
  position       String
  rating         Int
  listingJson    String
  status         String   @default("offered")
  offerAmount    Float
  counterAmount  Float?
  wageOffer      Float?
  contractYears  Int      @default(2)
  step           Int      @default(1)
  historyJson    String   @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, status])
  @@schema("alym")
}

// Chronicle Mode — récit de carrière (signature ALYM)
model ChronicleEntry {
  id        String   @id @default(cuid())
  teamId    Int
  season    Int      @default(1)
  week      Int      @default(1)
  type      String
  tone      String   @default("neutral")
  headline  String
  body      String
  metaJson  String?
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, season, week])
  @@index([teamId, createdAt])
  @@schema("alym")
}
