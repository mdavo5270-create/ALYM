generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["alym"]
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String?
  username     String?  @unique
  githubId     String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  teams        Team[]

  @@schema("alym")
}

model Team {
  id               Int      @id @default(autoincrement())
  userId           Int
  name             String   @unique
  nation           String?
  stadiumName      String?
  badgeDesign      Int?
  budget           Float    @default(200000)
  reputation       Int      @default(50)
  wins             Int      @default(0)
  draws            Int      @default(0)
  losses           Int      @default(0)
  goldBalance      Int      @default(0)
  tacticalVision   String   @default("standard")
  jobSecurity      Int      @default(70)
  youthPromoted    Int      @default(0)
  challengeId      String?
  challengeWins    Int      @default(0)
  challengeMatches Int      @default(0)
  challengeStreak  Int      @default(0)
  challengeYouth   Int      @default(0)
  createdAt        DateTime @default(now())

  user         User           @relation(fields: [userId], references: [id])
  players      Player[]
  messages     Message[]
  transactions Transaction[]
  achievements Achievement[]

  @@schema("alym")
}

model Player {
  id            Int       @id @default(autoincrement())
  name          String
  position      String
  nation        String?
  salary        Float
  speed         Int
  dribble       Int
  shot          Int
  pass          Int
  defense       Int
  physique      Int
  potential     Int       @default(70)
  isYouth       Boolean   @default(false)
  onLoan        Boolean   @default(false)
  trainingPlan  String    @default("balanced")
  isLegend      Boolean   @default(false)
  contractUntil DateTime?
  teamId        Int?
  createdAt     DateTime  @default(now())

  team Team? @relation(fields: [teamId], references: [id])

  @@schema("alym")
}

model League {
  id         Int       @id @default(autoincrement())
  name       String
  season     Int
  tier       Int
  teamsCount Int
  startDate  DateTime?
  endDate    DateTime?
  createdAt  DateTime  @default(now())
  matches    Match[]

  @@schema("alym")
}

model Match {
  id         Int       @id @default(autoincrement())
  leagueId   Int
  homeTeamId Int
  awayTeamId Int
  homeScore  Int?
  awayScore  Int?
  matchDate  DateTime?
  status     String    @default("scheduled")
  events     String?
  createdAt  DateTime  @default(now())

  league League @relation(fields: [leagueId], references: [id])

  @@schema("alym")
}

model Message {
  id          Int      @id @default(autoincrement())
  teamId      Int
  sender      String
  title       String
  content     String
  messageDate DateTime @default(now())
  read        Boolean  @default(false)

  team Team @relation(fields: [teamId], references: [id])

  @@schema("alym")
}

model Transaction {
  id              Int      @id @default(autoincrement())
  teamId          Int
  type            String
  amount          Float
  reason          String?
  transactionDate DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id])

  @@schema("alym")
}

model Achievement {
  id              Int      @id @default(autoincrement())
  teamId          Int
  achievementCode String
  unlockedAt      DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id])

  @@schema("alym")
}

model AiManager {
  id              Int      @id @default(autoincrement())
  name            String
  nation          String?
  reputation      Int      @default(50)
  preferredVision String   @default("standard")
  status          String   @default("free")
  seasonsAtClub   Int      @default(0)
  createdAt       DateTime @default(now())

  club AiClub?

  @@schema("alym")
}

model AiClub {
  id             Int      @id @default(autoincrement())
  name           String   @unique
  nation         String?
  reputation     Int      @default(50)
  budget         Float    @default(150000)
  tacticalVision String   @default("standard")
  leagueTier     Int      @default(2)
  jobSecurity    Int      @default(70)
  wins           Int      @default(0)
  draws          Int      @default(0)
  losses         Int      @default(0)
  managerId      Int?     @unique
  createdAt      DateTime @default(now())

  manager AiManager? @relation(fields: [managerId], references: [id])

  @@schema("alym")
}

model ManagerMarketEvent {
  id        Int      @id @default(autoincrement())
  type      String
  clubName  String
  managerName String?
  detail    String?
  createdAt DateTime @default(now())

  @@schema("alym")
}
