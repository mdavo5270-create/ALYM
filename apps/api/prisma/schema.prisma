generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String?
  username     String?  @unique
  githubId     String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  teams        Team[]
}

model Team {
  id           Int      @id @default(autoincrement())
  userId       Int
  name         String   @unique
  nation       String?
  stadiumName  String?
  badgeDesign  Int?
  budget       Float    @default(200000)
  reputation   Int      @default(50)
  wins         Int      @default(0)
  draws        Int      @default(0)
  losses       Int      @default(0)
  goldBalance  Int      @default(0)
  createdAt    DateTime @default(now())

  user         User           @relation(fields: [userId], references: [id])
  players      Player[]
  messages     Message[]
  transactions Transaction[]
  achievements Achievement[]
}

model Player {
  id            Int       @id @default(autoincrement())
  name          String
  position      String
  nation        String?
  salary        Float
  speed         Int
  dribble       Int
  shot          Int
  pass          Int
  defense       Int
  physique      Int
  contractUntil DateTime?
  teamId        Int?
  createdAt     DateTime  @default(now())

  team Team? @relation(fields: [teamId], references: [id])
}

model League {
  id         Int       @id @default(autoincrement())
  name       String
  season     Int
  tier       Int
  teamsCount Int
  startDate  DateTime?
  endDate    DateTime?
  createdAt  DateTime  @default(now())
  matches    Match[]
}

model Match {
  id         Int       @id @default(autoincrement())
  leagueId   Int
  homeTeamId Int
  awayTeamId Int
  homeScore  Int?
  awayScore  Int?
  matchDate  DateTime?
  status     String    @default("scheduled")
  events     String?
  createdAt  DateTime  @default(now())

  league League @relation(fields: [leagueId], references: [id])
}

model Message {
  id          Int      @id @default(autoincrement())
  teamId      Int
  sender      String
  title       String
  content     String
  messageDate DateTime @default(now())
  read        Boolean  @default(false)

  team Team @relation(fields: [teamId], references: [id])
}

model Transaction {
  id              Int      @id @default(autoincrement())
  teamId          Int
  type            String
  amount          Float
  reason          String?
  transactionDate DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id])
}

model Achievement {
  id              Int      @id @default(autoincrement())
  teamId          Int
  achievementCode String
  unlockedAt      DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id])
}
