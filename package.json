{
  "name": "alym",
  "version": "0.1.0",
  "private": true,
  "description": "ALYM - Athletic League Youth Manager",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c yellow,cyan \"yarn workspace @alym/web dev\" \"yarn workspace @alym/api dev\"",
    "dev:web": "yarn workspace @alym/web dev",
    "dev:api": "yarn workspace @alym/api dev",
    "build": "yarn workspaces foreach -A run build",
    "db:generate": "yarn workspace @alym/api db:generate",
    "db:migrate": "yarn workspace @alym/api db:migrate",
    "db:studio": "yarn workspace @alym/api db:studio",
    "setup": "yarn install && yarn db:generate && yarn db:migrate"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@1.22.22"
}
